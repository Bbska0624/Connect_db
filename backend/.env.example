# MongoDB Atlas connection string (replace <password> and <cluster>)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority&appName=Cluster0

# Express server port
PORT=5000

# JWT signing secret — use a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_long_random_secret_here

# Frontend origin allowed by CORS (set to deployed URL in production)
FRONTEND_URL=http://localhost:5174

# Gmail SMTP — use a Gmail App Password (not your account password)
# Enable at: Google Account → Security → 2-Step Verification → App passwords
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxxxxxx
